<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows SDK target for WinRT radio APIs (Bluetooth / Wi-Fi on/off). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <!-- Keep the exe where it always was (startup registry entry, shortcuts). -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\net10.0-windows\</OutputPath>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Exe, shortcuts and window title bars (WPF windows without an Icon use the exe's). Made by Assets\make-icon.ps1. -->
    <ApplicationIcon>Assets\doca.ico</ApplicationIcon>
    <AssemblyName>Doca</AssemblyName>
    <RootNamespace>Doca</RootNamespace>
    <!-- Program.Main starts the watchdog mode before WPF loads. -->
    <StartupObject>Doca.Program</StartupObject>
    <PlatformTarget>x64</PlatformTarget>
    <TieredPGO>true</TieredPGO>
    <!-- A shell runs all day: favor a small footprint over GC throughput. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <Version>0.2.0</Version>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ManagedShell" Version="0.0.374" />
  </ItemGroup>

  <ItemGroup>
    <!-- 0-9: higher compacts the large-object heap (icon bitmaps) more eagerly. -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
  </ItemGroup>

</Project>
